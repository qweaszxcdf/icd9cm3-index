{
  "$schema": "./workers/node_modules/wrangler/config-schema.json",
  "name": "icd9cm3-index",
  "main": "workers/src/index.js",
  "compatibility_date": "2026-07-13",
  "workers_dev": false,
  "previews": {},
  "build": {
    "command": "if [ -f workers/scripts/build.py ]; then python3 workers/scripts/build.py; else python3 scripts/build.py; fi"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "assets": {
    "directory": "./workers/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/tabular-pdf"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback",
      "database_id": "f755b043-bb86-4ea8-ae8c-e56991814433"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TABULAR_PDF",
      "bucket_name": "icd9cm3-index-pdf"
    }
  ]
}
