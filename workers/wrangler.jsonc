{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icd9cm3-index",
  "main": "src/index.js",
  "compatibility_date": "2026-07-13",
  "workers_dev": false,
  "previews": {},
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/tabular-pdf"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback",
      "database_id": "f755b043-bb86-4ea8-ae8c-e56991814433"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TABULAR_PDF",
      "bucket_name": "icd9cm3-index-pdf"
    }
  ]
}
