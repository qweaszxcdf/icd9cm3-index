{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icd9cm3-index",
  "main": "src/index.js",
  "compatibility_date": "2026-07-13",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/tabular-pdf"]
  },
  "r2_buckets": [
    {
      "binding": "TABULAR_PDF",
      "bucket_name": "icd9cm3-index-pdf"
    }
  ]
}
